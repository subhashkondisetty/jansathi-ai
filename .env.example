# Server Environment
NODE_ENV=development
PORT=5000

# MongoDB Connection String (Atlas or Local)
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jansathi?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/jansathi

# Logging Level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Request Body Limit (e.g. 100kb, 1mb)
BODY_LIMIT=100kb

# Trust Proxy (0 = disabled, 1 = true for reverse proxy like Render, Fly, Nginx)
TRUST_PROXY=0

# Rate Limiting Configurations
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AI_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_HOUR=10

# Authentication & Security
JWT_SECRET=jansathi-development-secret-jwt-key-2026
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Admin Creation CLI (optional, can also be provided via CLI flags)
ADMIN_EMAIL=admin@jansathi.gov.in
ADMIN_NAME=System Administrator
ADMIN_PASSWORD=AdminSecurePass2026!

# Audit Log Retention (Days before TTL deletion)
AUDIT_LOG_TTL_DAYS=180

# Document Storage & Upload Limits
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=300
STORAGE_DIR=server/storage/uploads

# Document Ingestion Pipeline
INGESTION_WORKER_ENABLED=true
INGESTION_CONCURRENCY=1
INGESTION_POLL_INTERVAL_MS=3000
INGESTION_MAX_ATTEMPTS=3
INGESTION_RETRY_BASE_DELAY_MS=5000
INGESTION_STALE_MINUTES=10
FETCH_TIMEOUT_MS=20000
MAX_FETCH_MB=25
FETCH_USER_AGENT=JanSathiBot/1.0
CHUNK_TARGET_CHARS=1000
CHUNK_MAX_CHARS=1500
CHUNK_OVERLAP_CHARS=150
ENABLE_OCR=false
KEEP_UPLOADED_FILES=false

# Mongoose Auto-Indexing (true in development, set false in high-throughput production if using syncIndexes)
AUTO_INDEX=true

# Client Configuration
CLIENT_ORIGIN=http://localhost:5173

# Client API Base URL (leave blank to use Vite development proxy '/api')
VITE_API_BASE_URL=
