# ==============================================================================
# JanSathi AI (जन साथी AI) — Environment Configuration Template
# ==============================================================================
# FORGE '26 — Theme 1: Civic Pulse
#
# IMPORTANT:
# 1. Copy this file to `.env` in the repository root for local development:
#      cp .env.example .env
# 2. NEVER commit actual `.env` files or secrets to version control.
# 3. In production (Render, Vercel, Container), set these via platform environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER ENVIRONMENT & RUNTIME
# ------------------------------------------------------------------------------
# Required: Node environment ('development', 'test', 'production')
NODE_ENV=development

# Required: Port on which Express server listens (Render dynamically provides PORT)
# Default in development: 5000
PORT=5000

# Optional: Reverse proxy trust level (0 = disabled, 1 = trust first proxy hop)
# In production on Render/Nginx, set TRUST_PROXY=1 to correctly resolve client IPs
TRUST_PROXY=0

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Required in production: MongoDB Atlas connection string.
# In development: defaults to mongodb://127.0.0.1:27017/jansathi if omitted.
# In production: MUST be a remote Atlas cluster (localhost/127.0.0.1 is rejected by Zod).
#
# Setup Guide for MongoDB Atlas:
#   a. Create a free M0 cluster or dedicated cluster on MongoDB Atlas.
#   b. Under Database Access, create a user with readWrite role on 'jansathi' database.
#   c. Under Network Access, whitelist your backend server's static egress IP or configure VPC Peering / PrivateLink. (See docs/DEPLOYMENT.md for network access security guidance).
#   d. Format: mongodb+srv://<db_username>:<db_password>@<cluster_address>/jansathi?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/jansathi

# Optional: Mongoose index synchronization (true in development, set false in high-throughput production)
AUTO_INDEX=true

# ------------------------------------------------------------------------------
# 3. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Required: Secret key used to sign and verify JWT authentication tokens.
# Constraints: Minimum 32 characters.
# In production: The default development key is strictly rejected by server startup validation.
#
# Generate a cryptographically secure 64-character hex secret via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or:
#   openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters

# Optional: JWT token expiration duration (e.g. '7d', '24h', '3600s')
JWT_EXPIRES_IN=7d

# Optional: bcrypt salt rounds for password hashing (min 4, max 16, default 12)
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 4. CORS ALLOWED ORIGINS (Client Application)
# ------------------------------------------------------------------------------
# Required: Comma-separated list of allowed frontend origins for CORS headers.
# Development: http://localhost:5173
# Production: https://<your-vercel-app>.vercel.app,https://<custom-domain>
CLIENT_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# 5. RATE LIMITING POLICIES
# ------------------------------------------------------------------------------
# Global rate limit window: 15 minutes
RATE_LIMIT_GLOBAL_MAX=300

# Auth endpoints rate limit window (/api/auth/*): 15 minutes
RATE_LIMIT_AUTH_MAX=10

# AI interaction endpoints rate limit window (/api/ai/*, /api/verify/*): 1 minute
RATE_LIMIT_AI_PER_MIN=20

# Document upload rate limit window (/api/documents/upload): 1 hour
RATE_LIMIT_UPLOAD_PER_HOUR=10

# ------------------------------------------------------------------------------
# 6. LOGGING & AUDIT
# ------------------------------------------------------------------------------
# Log level: 'fatal', 'error', 'warn', 'info', 'debug', 'trace'
LOG_LEVEL=info

# Request body size limit for Express JSON parser
BODY_LIMIT=100kb

# Retention period in days for audit logs before TTL index deletion
AUDIT_LOG_TTL_DAYS=180

# ------------------------------------------------------------------------------
# 7. DOCUMENT STORAGE & UPLOAD RESTRICTIONS
# ------------------------------------------------------------------------------
# Maximum PDF upload size in Megabytes
MAX_UPLOAD_MB=10

# Maximum allowable pages per uploaded PDF
MAX_PDF_PAGES=300

# Storage directory path for uploaded documents (relative to server root or absolute)
STORAGE_DIR=server/storage/uploads

# ------------------------------------------------------------------------------
# 8. BACKGROUND INGESTION WORKER DAEMON
# ------------------------------------------------------------------------------
# Enable or disable background IngestionRunner daemon
INGESTION_WORKER_ENABLED=true

# Concurrency bound (number of parallel jobs processed by this instance)
INGESTION_CONCURRENCY=1

# Polling interval in milliseconds for the queue
INGESTION_POLL_INTERVAL_MS=3000

# Maximum retry attempts before marking a job permanently failed
INGESTION_MAX_ATTEMPTS=3

# Base delay in milliseconds for exponential backoff retries
INGESTION_RETRY_BASE_DELAY_MS=5000

# Threshold in minutes after which stalled 'running' jobs are auto-recovered
INGESTION_STALE_MINUTES=10

# Timeout in milliseconds for fetching official government sources
FETCH_TIMEOUT_MS=20000

# Maximum download size in Megabytes for official source crawling
MAX_FETCH_MB=25

# User agent string sent during official source fetching
FETCH_USER_AGENT=JanSathiBot/1.0

# Ingestion chunking configuration
CHUNK_TARGET_CHARS=1000
CHUNK_MAX_CHARS=1500
CHUNK_OVERLAP_CHARS=150

# Optional OCR processing (requires tesseract.js and @napi-rs/canvas)
ENABLE_OCR=false

# Keep uploaded PDF files on disk after successful text extraction (default false cleans up disk)
KEEP_UPLOADED_FILES=false

# ------------------------------------------------------------------------------
# 9. ADMINISTRATIVE SEEDING CLI (Optional — for npm run create-admin)
# ------------------------------------------------------------------------------
# Credentials for the initial bootstrap administrator account:
ADMIN_EMAIL=admin@jansathi.gov.in
ADMIN_NAME=System Administrator
ADMIN_PASSWORD=replace_with_a_strong_password_minimum_8_chars

# ------------------------------------------------------------------------------
# 10. FRONTEND VITE CONFIGURATION (Client Workspace)
# ------------------------------------------------------------------------------
# In local development: Leave blank to use Vite development proxy (/api -> localhost:5000)
# In production on Vercel: Set to the full production backend API URL (e.g. https://jansathi-api.onrender.com/api)
VITE_API_BASE_URL=
