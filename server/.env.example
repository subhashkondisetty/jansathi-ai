# ==============================================================================
# JanSathi AI (जन साथी AI) — Server Environment Configuration Template
# ==============================================================================
# FORGE '26 — Theme 1: Civic Pulse
#
# IMPORTANT:
# - In local development: Copy to `.env` in repository root or in server directory.
# - In production (e.g. Render): Configure in Render Dashboard -> Environment Variables.
# - NEVER commit real credentials to version control.
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000
TRUST_PROXY=0

# MongoDB Atlas Database
# In development: defaults to mongodb://127.0.0.1:27017/jansathi if omitted.
# In production: MUST be a remote Atlas cluster URI (localhost is rejected).
# Format: mongodb+srv://<db_user>:<db_pass>@<cluster>.mongodb.net/jansathi?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/jansathi
AUTO_INDEX=true

# Authentication & Security
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Allowed Frontend Origins (CORS)
# Comma-separated list of origins
CLIENT_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AI_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_HOUR=10

# Logging & Limits
LOG_LEVEL=info
BODY_LIMIT=100kb
AUDIT_LOG_TTL_DAYS=180

# Upload & Storage
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=300
STORAGE_DIR=storage/uploads

# Background Ingestion Daemon
INGESTION_WORKER_ENABLED=true
INGESTION_CONCURRENCY=1
INGESTION_POLL_INTERVAL_MS=3000
INGESTION_MAX_ATTEMPTS=3
INGESTION_RETRY_BASE_DELAY_MS=5000
INGESTION_STALE_MINUTES=10
FETCH_TIMEOUT_MS=20000
MAX_FETCH_MB=25
FETCH_USER_AGENT=JanSathiBot/1.0
CHUNK_TARGET_CHARS=1000
CHUNK_MAX_CHARS=1500
CHUNK_OVERLAP_CHARS=150
ENABLE_OCR=false
KEEP_UPLOADED_FILES=false

# Bootstrap Admin Seeding (Optional)
ADMIN_EMAIL=admin@jansathi.gov.in
ADMIN_NAME=System Administrator
ADMIN_PASSWORD=replace_with_a_strong_password_minimum_8_chars
